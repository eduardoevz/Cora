# --- Secrets, Credentials & Medical Environment Configs (NEVER COMMIT) ---
.env
.env.*
!.env.example
!.env.*.example
secrets/
credenciales/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*service_account*.json
*firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist
firebase_options.dart

# --- Python / FastAPI Backend ---
