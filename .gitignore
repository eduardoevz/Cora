*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.uv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# --- Flutter / Dart Mobile ---
mobile/.dart_tool/
mobile/.packages
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
