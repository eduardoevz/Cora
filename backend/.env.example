# Entorno de ejecución: development | test | production
ENVIRONMENT=development
APP_NAME="Cora Backend"
APP_VERSION=0.1.0

# Base de Datos (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://cora_user:cora_password@localhost:5432/cora_db

# Firebase Auth (Verificación de tokens JWT)
FIREBASE_PROJECT_ID=cora-health-app
FIREBASE_CREDENTIALS_PATH=./secrets/firebase_service_account.json

# Cloudflare R2 (Object Storage S3-Compatible)
R2_ACCOUNT_ID=mock-r2-account-id
R2_ACCESS_KEY_ID=mock-access-key
R2_SECRET_ACCESS_KEY=mock-secret-key
R2_BUCKET_NAME=cora-medical-documents
R2_ENDPOINT_URL=https://mock-account.r2.cloudflarestorage.com

# Motor de IA / RAG Clínico (Google GenAI SDK >= 2.30.1)
GEMINI_API_KEY=mock-gemini-api-key
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_STORE_INTERACTIONS=false
