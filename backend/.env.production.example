# ==============================================================================
# Plantilla de Configuración de Entorno de Producción — Cora Backend
# ==============================================================================
# INSTRUCCIONES DE SEGURIDAD:
# 1. Copia este archivo como .env.production en el servidor o inyecta estas variables
#    directamente a través del panel de secretos de tu proveedor cloud (ej. Secret Manager).
# 2. NUNCA hagas commit de un archivo .env con credenciales reales en Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Entorno de Ejecución
# ------------------------------------------------------------------------------
# Debe ser 'production' para activar optimizaciones, seguridad estricta y logs estructurados.
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. Base de Datos Administrada (Neon Serverless PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
# Obtén la URI de conexión desde la consola de Neon (https://console.neon.tech).
# IMPORTANTE: Utiliza el driver 'postgresql+asyncpg://' y asegúrate de incluir '?ssl=require'.
# Para conexiones desde entornos serverless concurrentes, se recomienda usar el connection pooler (-pooler).
DATABASE_URL=postgresql+asyncpg://USUARIO:CONTRASENA@ep-IDENTIFICADOR-pooler.us-east-2.aws.neon.tech/cora_prod?ssl=require

# ------------------------------------------------------------------------------
# 3. Firebase Authentication (Verificación JWT de Usuarios Móviles)
# ------------------------------------------------------------------------------
# ID de tu proyecto en Firebase Console (https://console.firebase.google.com).
# Utilizado por el backend para validar la audiencia ('aud') y emisor ('iss') de los tokens Bearer.
FIREBASE_PROJECT_ID=cora-health-prod
# Opcional en PaaS (Render/Cloud Run): Contenido JSON completo del archivo de cuenta de servicio
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"cora-health-prod",...}

# ------------------------------------------------------------------------------
# 4. Almacenamiento Seguro Cloudflare R2 (Carpeta Clínica Digital / Zero-Egress)
# ------------------------------------------------------------------------------
# Endpoint S3 de tu cuenta Cloudflare: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Genera un token API en Cloudflare R2 con permisos de lectura y escritura para el bucket de Cora.
R2_ENDPOINT_URL=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=TU_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=TU_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=cora-medical-records-prod

# ------------------------------------------------------------------------------
# 5. Google Gemini API (Asistente Clínico & Embeddings Vectoriales)
# ------------------------------------------------------------------------------
# Llave de API generada en Google AI Studio (https://aistudio.google.com) o Vertex AI.
# El adaptador de Cora fuerza 'store=False' en toda llamada para garantizar privacidad clínica.
GEMINI_API_KEY=AIzaSyTU_GEMINI_API_KEY_AQUI

# ------------------------------------------------------------------------------
# 6. Observabilidad y Configuración de Servidor
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
PORT=8000
